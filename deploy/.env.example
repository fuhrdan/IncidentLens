# Copy to repository root as .env; chmod 600 .env; NEVER commit secrets.
# For compose interpolation, do not use semicolons in POSTGRES_PASSWORD.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
OIDC_AUTHORITY=https://id.example.com/realms/incidentlens
OIDC_AUDIENCE=incidentlens-api
# Register as a public SPA (no client secret), authorization code + PKCE S256.
OIDC_CLIENT_ID=incidentlens-spa
OIDC_SCOPE=openid profile
TENANT_CLAIM_TYPE=tenant_id
ROLE_CLAIM_TYPE=http://schemas.microsoft.com/ws/2008/06/identity/claims/role
